{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Twizz Tuneel",
  "version": "1.12.0",
  "identifier": "team.lolz.tunnel",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Twizz Tuneel",
        "width": 1266,
        "height": 793,
        "minWidth": 720,
        "minHeight": 540,
        "decorations": true,
        "resizable": true,
        "backgroundColor": "#0c0e0d"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https: http:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
